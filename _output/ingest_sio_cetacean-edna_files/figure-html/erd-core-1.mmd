---
config:
  layout: elk
---
erDiagram
    sample {
        varchar sample_key PK
        varchar sample_type
        varchar parent_sample_key FK
        varchar root_sample_key FK
        varchar dataset_key
        varchar grid_key
        varchar site_key
        varchar cruise_key
        int order_occ
        double latitude
        double longitude
        timestamp datetime
        double depth_min_m
        double depth_max_m
        varchar tow_type
        varchar data_stage
        geometry geom
        uuid source_uuid
    }
    obs {
        bigint obs_id PK
        varchar realm
        varchar dataset_key
        varchar sample_key FK
        varchar grid_key
        varchar cruise_key
        double latitude
        double longitude
        timestamp datetime
        double depth_min_m
        double depth_max_m
        varchar taxon_key FK
        varchar life_stage
        varchar measurement_type
        double measurement_value
        varchar measurement_qual
        double measurement_prec
        ubigint hex_id
    }
    taxon {
        varchar taxon_key PK
        int worms_id
        int itis_id
        bool gbif_id
        int ncbi_id
        int inat_id
        varchar scientific_name
        varchar common_name
        varchar rank
        int rank_order
        varchar taxonomic_status
        varchar status_checked
        varchar parent_taxon_key FK
        varchar kingdom
        varchar phylum
        varchar class
        varchar order_taxon
        varchar family
        varchar notes
    }
    dataset_taxon {
        varchar ds_taxon_key PK
        varchar dataset_key
        varchar taxon_key FK
        varchar ds_scientific_name
        varchar ds_common_name
        varchar ds_taxa_code
        varchar ds_source_json
    }
    taxon_group {
        varchar taxon_group_key PK
        varchar description
        varchar taxon_key PK,FK
    }
    sample ||--o{ sample : "parent_sample_key"
    sample ||--o{ sample : "root_sample_key"
    sample ||--o{ obs : "sample_key"
    taxon ||--o{ obs : "taxon_key"
    taxon ||--o{ dataset_taxon : "taxon_key"
    taxon ||--o{ taxon_group : "taxon_key"
    taxon ||--o{ taxon : "parent_taxon_key"
