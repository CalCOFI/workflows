---
config:
  layout: elk
---
erDiagram
    dungeness_sample {
        int dungeness_sample_id PK
        varchar cruise_orig
        varchar cruise_key
        varchar ship_key
        double line
        double station
        varchar site_key
        smallint order_occ
        date date
        timestamp datetime_start_utc
        double latitude
        double longitude
        varchar position_source
        varchar site_sample_key
        double aliquot
        double volume_ml
        varchar sorted_by
        varchar comments
        geometry geom
        varchar grid_key
    }
    dungeness_measurement_src {
        int dungeness_measurement_id
        int dungeness_sample_id FK
        varchar measurement_type
        double measurement_value
        varchar taxa_description
        varchar measurement_qual
    }
    dungeness_carapace_src {
        int dungeness_carapace_id
        int dungeness_sample_id FK
        int individual_num
        double carapace_length_mm
    }
    dungeness_sorting_log {
        int dungeness_sorting_log_id PK
        varchar sorting_status
        varchar expedition_orig
        varchar cruise_ym
        varchar cruise_key
        double line
        double station
        varchar site_key
        double latitude
        double longitude
        date date
        timestamp datetime_start_utc
        timestamp datetime_end_utc
        double max_depth_m
        varchar net
        double mesh_mm
        varchar tow_type
        varchar preservative
        varchar sorted_by
        geometry geom
        varchar grid_key
    }
    dungeness_specimen {
        int specimen_num PK
        varchar cruise_orig
        double line
        double station
        varchar site_key
        date date
        timestamp datetime_start_utc
        bool is_magister
        double carapace_length_mm
        varchar notes
    }
    dataset {
        varchar provider
        varchar dataset
        varchar dataset_name
        varchar dataset_name_short
        varchar category
        varchar color
        varchar description
        varchar citation_main
        varchar citation_others
        varchar link_calcofi_org
        varchar link_data_source
        varchar link_others
        varchar tables
        varchar coverage_temporal
        varchar coverage_spatial
        varchar license
        varchar pi_names
        varchar doi
        varchar license_url
        varchar acknowledgement
        varchar contact
    }
    dungeness_sample ||--o{ dungeness_measurement_src : "dungeness_sample_id"
    dungeness_sample ||--o{ dungeness_carapace_src : "dungeness_sample_id"
    classDef lightblue stroke:#ADD8E6,stroke-width:3px
    class dungeness_sample,dungeness_measurement_src,dungeness_carapace_src lightblue
    classDef lightgreen stroke:#90EE90,stroke-width:3px
    class dungeness_sorting_log,dungeness_specimen lightgreen
    classDef white stroke:#FFFFFF,stroke-width:3px
    class dataset white
