---
config:
  layout: elk
---
erDiagram
    obs {
        bigint obs_id PK
        varchar realm
        varchar dataset_key
        varchar sample_key
        varchar grid_key
        varchar cruise_key
        double latitude
        double longitude
        timestamp datetime
        double depth_min_m
        double depth_max_m
        varchar taxon_key
        varchar life_stage
        varchar measurement_type FK
        double measurement_value
        varchar measurement_qual
        double measurement_prec
        ubigint hex_id
    }
    sample_measurement {
        bigint sample_measurement_id PK
        varchar sample_key
        varchar dataset_key
        varchar measurement_type FK
        double measurement_value
        varchar measurement_qual
    }
    ctd_geostrophic {
        varchar cruise_key PK
        double line
        varchar site_key_1
        varchar site_key_2
        varchar sample_key_1 PK
        varchar sample_key_2 PK
        double dist_mid_km
        double dx_km
        double pressure_min_dbar PK
        double pressure_max_dbar
        double velocity_m_s
        bool shallow
        varchar data_stage
    }
    measurement_type {
        varchar measurement_type PK
        varchar description
        varchar units
        double valid_min
        double valid_max
        double valid_depth_min_m
        double valid_depth_max_m
        varchar derivation
        bool is_canonical
        varchar _source_column
        varchar _source_table
        varchar _source_datasets
        varchar _qual_column
        varchar _prec_column
        varchar grain
        varchar denominator
        varchar category
        varchar variable
        varchar nerc_p01
        varchar units_nerc_p06
    }
    measurement_type ||--o{ obs : "measurement_type"
    measurement_type ||--o{ sample_measurement : "measurement_type"
    classDef lightblue stroke:#ADD8E6,stroke-width:3px
    class obs,sample_measurement,ctd_geostrophic lightblue
    classDef lightyellow stroke:#FFFFE0,stroke-width:3px
    class measurement_type lightyellow
