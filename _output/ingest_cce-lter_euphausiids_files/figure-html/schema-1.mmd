---
config:
  layout: elk
---
erDiagram
    euphausiids_tow {
        int tow_id PK
        varchar cruise_key
        varchar ship_key
        varchar ship_name
        varchar cruise_orig
        varchar site_key
        double line
        double station
        varchar region
        timestamp datetime_start_utc
        timestamp datetime_end_utc
        double latitude
        double longitude
        geometry geom
        varchar grid_key
    }
    euphausiids_taxon {
        int taxon_id PK
        varchar scientific_name
        varchar genus
        varchar species
        int worms_id
        int itis_id
    }
    euphausiids_measurement {
        bigint euphausiids_measurement_id PK
        int tow_id FK
        int taxon_id FK
        varchar life_stage
        varchar measurement_type FK
        double measurement_value
        varchar measurement_qual
    }
    euphausiids_summary {
        varchar site_key
        timestamp datetime_start_utc
        double latitude
        double longitude
        int taxon_id
        varchar life_stage
        varchar measurement_type
        double avg
        double stddev
        bigint n_obs
    }
    measurement_type {
        varchar measurement_type PK
        varchar description
        varchar units
        double valid_min
        double valid_max
        double valid_depth_min_m
        double valid_depth_max_m
        varchar derivation
        bool is_canonical
        varchar _source_column
        varchar _source_table
        varchar _source_datasets
        varchar _qual_column
        varchar _prec_column
        varchar grain
        varchar denominator
        varchar category
        varchar variable
        varchar nerc_p01
        varchar units_nerc_p06
    }
    dataset {
        varchar provider
        varchar dataset
        varchar dataset_name
        varchar dataset_name_short
        varchar category
        varchar color
        varchar description
        varchar citation_main
        varchar citation_others
        varchar link_calcofi_org
        varchar link_data_source
        varchar link_others
        varchar tables
        varchar coverage_temporal
        varchar coverage_spatial
        varchar license
        varchar pi_names
        varchar doi
        varchar license_url
        varchar acknowledgement
        varchar contact
    }
    euphausiids_tow ||--o{ euphausiids_measurement : "tow_id"
    euphausiids_taxon ||--o{ euphausiids_measurement : "taxon_id"
    measurement_type ||--o{ euphausiids_measurement : "measurement_type"
    classDef lightblue stroke:#ADD8E6,stroke-width:3px
    class euphausiids_tow,euphausiids_measurement,euphausiids_summary lightblue
    classDef lightgreen stroke:#90EE90,stroke-width:3px
    class euphausiids_taxon lightgreen
    classDef lightyellow stroke:#FFFFE0,stroke-width:3px
    class measurement_type lightyellow
    classDef white stroke:#FFFFFF,stroke-width:3px
    class dataset white
