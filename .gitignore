.Rproj.user
.Rhistory
.RData
.Ruserdata
.DS_Store
.env
.env.swp
/.quarto/
**/*.quarto_ipynb
_docs
data/tmp/
.tmp/
.positai
# microsoft office temp/lock files
~$*
# transient render/upload logs dropped at the repo root by quarto render and the
# release upload; the deliberately archived sync logs live in data/logs/
/*.log
# quarto render artifacts left beside the .qmd at the repo root — the published
# copies live under _output/ (e.g. _output/release_database_files/)
/*_files/

# generated NetCDF publish artifacts (170MB+); published to GCS, not tracked here
data/netcdf/

# generated EDI publish artifacts (CSV entities can run into the GB per dataset);
# staged to GCS for PASTA evaluate/create, not tracked here — same as data/netcdf/
data/edi/
data/edi-staging/
# the publishers' shared per-dataset signature cache + the portal status report
# (publish_status.qmd uploads the report to gs://calcofi-db/publish/portal_status.csv)
data/publish/
# generated Darwin Core Archives (the ichthyo zip alone is 46MB); uploaded to the
# OBIS-USA IPT by hand, never tracked here. The manifests beside them ARE the record
# of what was uploaded, and are small — but they are per-machine build output too,
# so distribution.csv stays the durable record of a published OBIS dataset.
data/darwincore/
data/darwincore-staging/

# quarto leaves this behind when a render dies mid-way
*.rmarkdown

# Claude Code per-machine settings (paths are local to one machine)
.claude/settings.local.json

# run logs written by a detached launch (nohup … > _output/<run>.log)
_output/*.log

# deck builds: one .pptx per deck is tracked; scratch copies, unpacked dirs and the
# pre-polish original stay local (presentations/build_*.R regenerates them)
presentations/_to_delete/
presentations/*copy*.pptx
presentations/2026-09-08_CalCOFI.io_update_polished/
presentations/2026-09-08_CalCOFI.io_update.pptx
