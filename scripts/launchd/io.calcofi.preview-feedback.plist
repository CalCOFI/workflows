<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- every 10 min: one private GitHub issue per feedback report sent from a dataset preview
     (scripts/preview_feedback_issues.py). Load: see preview/README.md "Timers". -->
<plist version="1.0"><dict>
  <key>Label</key><string>io.calcofi.preview-feedback</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>-lc</string>
    <string>source ~/.config/calcofi/env.sh; cd ~/Github/CalCOFI/workflows &amp;&amp; python3 scripts/preview_feedback_issues.py</string></array>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/bbest/_big/calcofi/logs/preview_feedback.log</string>
  <key>StandardErrorPath</key><string>/Users/bbest/_big/calcofi/logs/preview_feedback.log</string>
</dict></plist>
