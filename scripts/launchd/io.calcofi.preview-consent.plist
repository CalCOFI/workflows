<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- every 10 min: fold each decision from a dataset preview's form into the dataset's consent
     question, push the row to the provider's Google Sheet and commit the CSV on main
     (scripts/pull_preview_consent.R). Load: see preview/README.md "Timers". -->
<plist version="1.0"><dict>
  <key>Label</key><string>io.calcofi.preview-consent</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>-lc</string>
    <string>source ~/.config/calcofi/env.sh; cd ~/Github/CalCOFI/workflows &amp;&amp; Rscript scripts/pull_preview_consent.R --execute --push-sheets --commit</string></array>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/bbest/_big/calcofi/logs/preview_consent.log</string>
  <key>StandardErrorPath</key><string>/Users/bbest/_big/calcofi/logs/preview_consent.log</string>
</dict></plist>
