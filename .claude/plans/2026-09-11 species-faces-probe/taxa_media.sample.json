   "text": {
    "source": "wikipedia",
    "title": "Sardinops",
    "url": "https://en.wikipedia.org/wiki/Sardinops_sagax",
    "revision": "1371053494",
    "timestamp": "2026-08-24",
    "license": "CC BY-SA 4.0",
    "about": "genus",
    "extract": "Sardinops is a genus of sardines of the family Alosidae. It is found in the Indo-Pacific, East Pacific, Southeastern Atlantic, and southwestern Indian oceans. Its length is up to 40 cm (16 in). It has numerous common or vernacular names, some of which more appropriately refer to subspecies, including blue pilchard, blue-bait, South American pilchard, Chilean sardine, and Pacific sardine.",
    "lead": "Sardinops is a genus of sardines of the family Alosidae. It is found in the Indo-Pacific, East Pacific, Southeastern Atlantic, and southwestern Indian oceans."
