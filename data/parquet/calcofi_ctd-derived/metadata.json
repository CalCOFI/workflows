    "ctd_geostrophic.dist_mid_km": {
      "name_long": "Pair midpoint distance",
      "units": "km",
      "description_md": "Along-line distance of the pair midpoint from the first station used, nearshore = 0"
    },
    "ctd_geostrophic.dx_km": {
      "name_long": "Station spacing",
      "units": "km",
      "description_md": "Great-circle distance between the two stations"
    },
    "ctd_geostrophic.pressure_min_dbar": {
      "name_long": "Pressure bin top",
      "units": "dbar",
      "description_md": "Top of the 10 dbar bin (0 = surface bin)"
    },
    "ctd_geostrophic.pressure_max_dbar": {
      "name_long": "Pressure bin bottom",
      "units": "dbar",
      "description_md": "Bottom of the 10 dbar bin"
    },
    "ctd_geostrophic.velocity_m_s": {
      "name_long": "Relative geostrophic velocity",
      "units": "m/s",
      "description_md": "Bin-mean velocity relative to 500 dbar; positive equatorward (90 degrees left of the offshore direction on a line running west-south-west)"
    },
    "ctd_geostrophic.shallow": {
      "name_long": "Shallow pair",
      "description_md": "TRUE when a cast of the pair is shallower than 500 dbar, so its deepest density is carried down (questions.csv Q03)"
    },
    "ctd_geostrophic.data_stage": {
      "name_long": "Data stage",
      "description_md": "The less-processed data_stage of the two casts"
    },
